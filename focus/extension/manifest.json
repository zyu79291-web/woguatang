{
  "manifest_version": 3,
  "name": "窝瓜汤专注开关",
  "version": "1.0.0",
  "description": "只保留窝瓜汤、ChatGPT 和 PTE 学姐；随时结束专注。",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "窝瓜汤专注开关"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8765/*",
        "http://127.0.0.1:8765/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}